<%- include('partials/header') %>

<main class="py-24 bg-slate-50 min-h-screen">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <div id="create-internship-card" class="bg-white rounded-[40px] p-12 border border-slate-100 shadow-xl shadow-blue-900/5">
      <div class="mb-12">
        <h2 class="text-3xl font-black text-slate-800 tracking-tight">Post a New Opportunity</h2>
        <p class="text-slate-500 font-medium mt-2">Find the perfect candidate with AI-powered skill matching.</p>
      </div>

      <form action="/admin/create-internship" method="POST" class="space-y-8">
        <div class="grid md:grid-cols-2 gap-8">
          <div>
            <label class="block text-slate-700 font-bold mb-3 ml-1 text-sm">Internship Title</label>
            <input type="text" name="title" required placeholder="e.g. Frontend Developer Intern" class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:border-blue-400 focus:ring-0 transition-all font-medium text-slate-800">
          </div>
          <div>
            <label class="block text-slate-700 font-bold mb-3 ml-1 text-sm">Company Name</label>
            <input type="text" name="company" required placeholder="e.g. Google" class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:border-blue-400 focus:ring-0 transition-all font-medium text-slate-800">
          </div>
        </div>

        <div>
           <label class="block text-slate-700 font-bold mb-3 ml-1 text-sm">Description</label>
           <textarea rows="4" name="description" required placeholder="Briefly describe the role, responsibilities, and team..." class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:border-blue-400 focus:ring-0 transition-all font-medium text-slate-800"></textarea>
        </div>

        <div>
            <label class="block text-slate-700 font-bold mb-3 ml-1 text-sm">Required Skills (Comma separated)</label>
            <input type="text" name="requiredSkills" required placeholder="e.g. React, Node.js, Python" class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:border-blue-400 focus:ring-0 transition-all font-medium text-slate-800">
            <p class="text-[10px] text-slate-400 font-black tracking-widest uppercase mt-3 ml-1">AI uses these for matching scoring</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
            <div>
              <label class="block text-slate-700 font-bold mb-3 ml-1 text-sm">Location</label>
              <input type="text" name="location" required placeholder="e.g. Remote / London" class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:border-blue-400 focus:ring-0 transition-all font-medium text-slate-800">
            </div>
            <div>
              <label class="block text-slate-700 font-bold mb-3 ml-1 text-sm">Duration</label>
              <input type="text" name="duration" required placeholder="e.g. 3 Months / 6 Months" class="w-full px-5 py-4 bg-slate-50 border border-slate-200 rounded-2xl focus:border-blue-400 focus:ring-0 transition-all font-medium text-slate-800">
            </div>
          </div>

        <div class="pt-6">
            <button type="submit" class="w-full py-5 bg-blue-600 hover:bg-black text-white font-extrabold rounded-2xl transition-all shadow-lg shadow-blue-200 active:scale-95">Post Opportunity</button>
        </div>
      </form>
    </div>
  </div>
</main>

<script>
  gsap.from("#create-internship-card", {
    scale: 0.95,
    opacity: 0,
    duration: 1.2,
    ease: "power3.out"
  });

  gsap.from("form > div", {
    opacity: 0,
    y: 10,
    stagger: 0.1,
    duration: 0.8,
    ease: "power2.out",
    delay: 0.3
  });
</script>

<%- include('partials/footer') %>
