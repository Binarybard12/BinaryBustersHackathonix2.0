<%- include('partials/header') %>

<main class="py-12 bg-slate-50 min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex flex-col md:flex-row justify-between items-end mb-12">
      <div>
        <h1 class="text-4xl font-black text-slate-900 mb-4 tracking-tight">Available Internships</h1>
        <p class="text-slate-500 text-lg">Browse and apply to the best opportunities matching your profile.</p>
      </div>
      <div class="mt-6 md:mt-0 flex gap-4">
        <input type="text" placeholder="Search roles, companies..." class="px-5 py-3 rounded-2xl border border-slate-200 focus:border-blue-400 focus:ring-0 shadow-sm w-full md:w-64">
        <button class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-2xl font-bold shadow-lg shadow-blue-200 transition-all">Search</button>
      </div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% internships.forEach((job, index) => { %>
          <div class="gs-job-card bg-white rounded-[24px] p-8 border border-slate-100 shadow-sm hover:shadow-xl transition-all group overflow-hidden relative flex flex-col h-full">
              <div class="absolute top-0 right-0 p-5">
                  <div class="bg-blue-50 text-blue-600 px-3 py-1.5 rounded-full text-xs font-black shadow-sm border border-blue-100">
                     <%= job.matchScore %>% Match
                  </div>
              </div>
              
              <div class="flex items-center gap-4 mb-6">
                <div class="w-16 h-16 bg-slate-50 border border-slate-100 rounded-2xl flex items-center justify-center text-2xl font-bold text-slate-400 group-hover:scale-110 transition-transform shadow-inner">
                    <%= (job.company && job.company.length > 0) ? job.company[0] : 'I' %>
                </div>
                <div>
                  <h4 class="text-xl font-bold text-slate-800 group-hover:text-blue-600 transition-colors"><%= job.title %></h4>
                  <p class="text-slate-500 font-medium"><%= job.company %></p>
                </div>
              </div>

              <div class="mb-6 flex-grow">
                <p class="text-slate-500 text-sm flex items-center mb-4">
                    <svg class="w-4 h-4 mr-2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                    <%= job.location %>
                </p>
                <div class="flex flex-wrap gap-2">
                    <% (job.skills || []).forEach(skill => { %>
                        <span class="px-2.5 py-1 bg-slate-50 text-slate-500 text-[11px] font-bold rounded-lg border border-slate-100 uppercase tracking-wider"><%= skill %></span>
                    <% }); %>
                </div>
              </div>

              <div class="space-y-5 mt-auto">
                  <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden">
                      <div class="gs-progress-bar h-full bg-gradient-to-r from-blue-400 to-blue-600 w-0" data-value="<%= job.matchScore %>"></div>
                  </div>
                  <button class="w-full py-4 bg-slate-900 text-white font-black rounded-2xl hover:bg-black transition-all active:scale-95 shadow-md">Apply Now</button>
              </div>
          </div>
      <% }); %>
    </div>
    
  </div>
</main>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Stagger Job Cards
    gsap.from(".gs-job-card", {
        opacity: 0,
        y: 40,
        stagger: 0.1,
        duration: 0.8,
        ease: "power3.out"
    });

    // 2. Fill Progress Bars
    gsap.to(".gs-progress-bar", {
        width: (index, target) => target.getAttribute('data-value') + "%",
        duration: 1.5,
        stagger: 0.1,
        ease: "power2.out",
        delay: 0.5
    });
  });
</script>

<%- include('partials/footer') %>
