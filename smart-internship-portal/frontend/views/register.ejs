<%- include('partials/header') %>

<main class="py-24 bg-slate-50 min-h-[calc(100vh-16rem)] flex items-center justify-center">
  <div class="max-w-md w-full px-4">
    <div id="register-card" class="bg-white rounded-[32px] p-10 border border-slate-100 shadow-xl shadow-blue-900/5">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-black text-slate-800 tracking-tight">Create Account</h2>
        <p class="text-slate-400 font-medium mt-2">Join ProMatch and find your dream internship</p>
      </div>

      <% if (error) { %>
        <div class="mb-6 px-4 py-3 bg-red-50 border border-red-100 text-red-600 rounded-2xl text-sm font-bold text-center">
          <%= error %>
        </div>
      <% } %>

      <form action="/register" method="POST" class="space-y-4">
        <div>
          <label class="block text-slate-700 font-bold mb-1 ml-1 text-sm">Full Name</label>
          <input type="text" name="name" required placeholder="John Doe" class="w-full px-5 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:border-blue-400 focus:ring-0 transition-all font-medium text-slate-800">
        </div>
        <div>
          <label class="block text-slate-700 font-bold mb-1 ml-1 text-sm">University</label>
          <input type="text" name="university" required placeholder="Imperial College" class="w-full px-5 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:border-blue-400 focus:ring-0 transition-all font-medium text-slate-800">
        </div>
        <div>
          <label class="block text-slate-700 font-bold mb-1 ml-1 text-sm">Email Address</label>
          <input type="email" name="email" required placeholder="student@university.edu" class="w-full px-5 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:border-blue-400 focus:ring-0 transition-all font-medium text-slate-800">
        </div>
        <div>
          <label class="block text-slate-700 font-bold mb-1 ml-1 text-sm">Password</label>
          <input type="password" name="password" required placeholder="••••••••" class="w-full px-5 py-3 bg-slate-50 border border-slate-200 rounded-2xl focus:border-blue-400 focus:ring-0 transition-all font-medium text-slate-800">
        </div>
        
        <button type="submit" class="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white font-extrabold rounded-2xl transition-all shadow-lg shadow-blue-200 mt-6 active:scale-95">Register Now</button>
      </form>

      <div class="mt-8 pt-8 border-t border-slate-100 text-center">
        <p class="text-slate-500 font-medium text-sm">Already have an account? <a href="/login" class="text-blue-600 font-bold hover:underline">Sign In</a></p>
      </div>
    </div>
  </div>
</main>

<script>
  gsap.from("#register-card", {
    y: 30,
    opacity: 0,
    duration: 1,
    ease: "back.out(1.7)"
  });

  gsap.from("form > div", {
    opacity: 0,
    x: -20,
    stagger: 0.1,
    duration: 0.8,
    ease: "power2.out",
    delay: 0.3
  });
</script>

<%- include('partials/footer') %>
