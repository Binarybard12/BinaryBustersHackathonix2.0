<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .nav-link { @apply text-gray-600 hover:text-blue-600 font-medium transition-colors; }
    .btn-primary { @apply px-5 py-2.5 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-all shadow-sm; }
    .btn-secondary { @apply px-5 py-2.5 bg-white border border-gray-200 text-gray-700 font-semibold rounded-lg hover:bg-gray-50 transition-all; }
  </style>
  <link rel="stylesheet" href="/output.css">
</head>
<body class="bg-slate-50 min-h-screen">
  <nav class="bg-white/80 backdrop-blur-md border-b sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16 items-center">
        <div class="flex items-center space-x-2">
          <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-blue-200">
            P
          </div>
          <span class="text-xl font-bold text-slate-800">ProMatch AI</span>
        </div>
        <div class="hidden md:flex items-center space-x-8">
          <a href="/" class="text-blue-600 font-semibold">Home</a>
          <a href="/internship-listings" class="text-gray-600 hover:text-blue-600 font-medium">Internships</a>
          <a href="/dashboard" class="text-gray-600 hover:text-blue-600 font-medium">Dashboard</a>
          <a href="/login" class="btn-secondary">Login</a>
          <a href="/upload-resume" class="btn-primary">Get Started</a>
        </div>
        <div class="md:hidden">
            <!-- Mobile menu button -->
            <button class="p-2 text-gray-400 hover:text-gray-600">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path></svg>
            </button>
        </div>
      </div>
    </div>
  </nav>
