<%- include('partials/header') %>

<main class="py-24 bg-slate-50 min-h-[calc(100vh-16rem)]">
  <div class="max-w-2xl mx-auto px-4 sm:px-6">
    <div id="upload-step-1" class="bg-white rounded-[40px] p-12 border border-slate-100 shadow-xl shadow-blue-900/5 text-center">
      <div class="w-20 h-20 bg-blue-50 text-blue-600 rounded-3xl flex items-center justify-center mx-auto mb-8 shadow-inner">
        <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"></path></svg>
      </div>
      <h2 class="text-3xl font-black text-slate-800 mb-4 tracking-tight">Upload Your Resume</h2>
      <p class="text-slate-500 mb-12 max-w-sm mx-auto leading-relaxed">Let our AI extract your professional DNA. We support high-quality PDF and DOCX files.</p>
      
      <form action="/upload-resume" method="POST" enctype="multipart/form-data" id="resume-form">
        <div class="group relative bg-slate-50 hover:bg-white border-2 border-dashed border-slate-200 hover:border-blue-400 p-12 rounded-3xl transition-all cursor-pointer mb-8">
          <input type="file" name="resume" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer" id="resume-input" accept=".pdf,.docx">
          <div class="flex flex-col items-center">
            <span class="text-slate-400 font-bold group-hover:text-blue-600 transition-colors" id="file-name-label">Drag and drop or click to browse</span>
            <span class="text-[10px] text-slate-300 font-black tracking-widest uppercase mt-4">Max 5MB • PDF/DOCX</span>
          </div>
        </div>
        <button type="submit" class="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white font-extrabold rounded-2xl transition-all shadow-lg shadow-blue-200" id="upload-btn">Start Extraction</button>
      </form>

      <div class="mt-8 flex items-center justify-center space-x-6 text-slate-400 font-bold text-xs uppercase tracking-widest opacity-50">
        <span class="flex items-center space-x-2"><span class="w-2 h-2 bg-slate-400 rounded-full"></span><span>Secure</span></span>
        <span class="flex items-center space-x-2"><span class="w-2 h-2 bg-slate-400 rounded-full"></span><span>AI-Verified</span></span>
        <span class="flex items-center space-x-2"><span class="w-2 h-2 bg-slate-400 rounded-full"></span><span>Instant Matches</span></span>
      </div>
    </div>

    <!-- Processing Overlay (Hidden) -->
    <div id="processing-overlay" class="hidden fixed inset-0 z-[100] bg-slate-900/80 backdrop-blur-xl flex flex-col items-center justify-center text-white">
        <div class="relative w-24 h-24 mb-12">
            <svg class="w-full h-full animate-[spin_3s_linear_infinite]" viewBox="0 0 100 100">
                <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="8" />
                <circle cx="50" cy="50" r="45" fill="none" stroke="#2563eb" stroke-width="8" stroke-dasharray="20, 200" stroke-linecap="round" />
            </svg>
            <div class="absolute inset-0 flex items-center justify-center text-4xl font-black">AI</div>
        </div>
        <h3 class="text-4xl font-extrabold mb-4 text-center tracking-tighter">Analyzing Professional DNA...</h3>
        <p class="text-slate-400 font-bold text-sm tracking-widest uppercase" id="processing-status">Tokenizing Experience</p>
        
        <div class="w-64 h-1 bg-white/10 rounded-full mt-12 overflow-hidden relative">
            <div class="absolute inset-0 bg-blue-600 rounded-full animate-[shimmer_2s_infinite]"></div>
        </div>
    </div>
  </div>
</main>

<style>
@keyframes shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}
</style>

<script>
  const form = document.getElementById('resume-form');
  const input = document.getElementById('resume-input');
  const label = document.getElementById('file-name-label');
  const overlay = document.getElementById('processing-overlay');
  const statusLabel = document.getElementById('processing-status');

  input.addEventListener('change', (e) => {
    if (e.target.files.length > 0) {
      label.textContent = e.target.files[0].name;
      label.classList.add('text-blue-600');
    }
  });

  form.addEventListener('submit', (e) => {
    // Only intercept once for the animation
    if (form.dataset.processing === 'true') return;
    
    e.preventDefault();
    overlay.classList.remove('hidden');
    form.dataset.processing = 'true';
    
    // GSAP Overlay Fade In
    gsap.from(overlay, { opacity: 0, duration: 0.5 });

    // Status Updates
    const statuses = ["Extracting Raw Text", "Cleaning Tokens", "Identifying Skill Clusters", "Matching with Database", "Finalizing Analysis"];
    let step = 0;
    const interval = setInterval(() => {
        if (step < statuses.length) {
            statusLabel.textContent = statuses[step];
            gsap.from(statusLabel, { opacity: 0, y: 10, duration: 0.3 });
            step++;
        } else {
            clearInterval(interval);
            form.submit(); // Real submission
        }
    }, 800);
  });

  // Entrance Animation
  gsap.from("#upload-step-1", {
    scale: 0.9,
    opacity: 0,
    duration: 1,
    ease: "power3.out"
  });
</script>

<%- include('partials/footer') %>
